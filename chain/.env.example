# ===========================================
# LOGGER runtime env config e.g.: info, debug, warn, error
# ===========================================
LOG_LEVEL=debug

SERVER_NAME=chain
SERVER_HOST=localhost

# ===========================================
# Server env config
# ===========================================
REST_PORT=18809

# ===========================================
# GRPC env config
# ===========================================
GRPC_PORT=18709

# ===========================================
# JWT env config
# ===========================================
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
# second
JWT_ACCESS_TTL=7200
JWT_REFRESH_ACCESS_TTL=604800

# ===========================================
# Consul env config
# ===========================================
CONSUL_HOST=localhost
CONSUL_PORT=8500
CONSUL_ACL_TOKEN=change-me
CONSUL_TIMEOUT=5

# ===========================================
# Database env config
# ===========================================
DB_TYPE=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_LOGIN_ID=root
DB_PASSWORD=change-me
DB_SCHEMA=axis_chain
DB_SSL_MODE=disable
DB_PATH=data/chain/data.db

# ===========================================
# Redis env config
# ===========================================
REDIS_HEALTH_CHECK_INTERVAL=30
READ_REDIS_ADDRESS=localhost:6379
READ_REDIS_DB=0
READ_REDIS_DISABLE_CACHE=false
READ_REDIS_PASSWORD=change-me

WRITE_REDIS_ADDRESS=localhost:6379
WRITE_REDIS_DB=0
WRITE_REDIS_DISABLE_CACHE=false
WRITE_REDIS_PASSWORD=change-me

# ===========================================
# Mongo env config
# ===========================================

# ===========================================
# Kafka env config
# ===========================================
# KAFKA_BROKERS=127.0.0.1:9092

# RPC / WSS endpoints stay in env, never in source.
# CHAIN_RPC_HTTP=
# CHAIN_RPC_WSS=
