meta {
  name: Create parent menu
  type: http
  seq: 2
}
post {
  url: {{auth_base}}/rbac/menus
  body: json
  auth: inherit
}
headers {
  X-Request-ID: {{X-Request-ID}}
}
body:json {
  {
    "parent_id": 0,
    "code": "{{menu_code}}",
    "name": "Postman \u5546\u54c1",
    "path": "/pm/product",
    "icon": "box",
    "sort": 10
  }
}
tests {
  function __raw() {
    const value = res.getBody();
    return typeof value === "string" ? value : JSON.stringify(value);
  }

  function __json() {
    const value = res.getBody();
    return typeof value === "string" ? JSON.parse(value) : value;
  }

  const json = __json();
  test('HTTP 200', () => expect(res.status).to.eql(200));
  test('business code 0', () => expect(json.code).to.eql(0));

  test('menu id present', () => expect(json.data.id).to.exist);
  const menuId = __raw().match(/"id"\s*:\s*(\d+)/);
  bru.setVar('menu_id', menuId[1]);
}
