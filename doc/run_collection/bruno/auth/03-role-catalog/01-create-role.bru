meta {
  name: Create role
  type: http
  seq: 1
}
post {
  url: {{auth_base}}/rbac/roles
  body: json
  auth: inherit
}
headers {
  X-Request-ID: {{X-Request-ID}}
}
body:json {
  {
    "code": "{{role_code}}",
    "name": "Postman \u7f16\u8f91",
    "description": "flow test role"
  }
}
tests {
  function __raw() {
    const value = res.getBody();
    return typeof value === "string" ? value : JSON.stringify(value);
  }

  function __json() {
    const value = res.getBody();
    return typeof value === "string" ? JSON.parse(value) : value;
  }

  const json = __json();
  test('HTTP 200', () => expect(res.status).to.eql(200));
  test('business code 0', () => expect(json.code).to.eql(0));

  test('role id present', () => expect(json.data.id).to.exist);
  const roleId = __raw().match(/"id"\s*:\s*(\d+)/);
  bru.setVar('role_id', roleId[1]);
}
