meta {
  name: Invalid role status (expect fail)
  type: http
  seq: 6
}
patch {
  url: {{auth_base}}/rbac/roles/{{role_id}}/status
  body: json
  auth: inherit
}
headers {
  X-Request-ID: {{X-Request-ID}}
}
body:json {
  {
    "status": 9
  }
}
tests {
  function __raw() {
    const value = res.getBody();
    return typeof value === "string" ? value : JSON.stringify(value);
  }

  function __json() {
    const value = res.getBody();
    return typeof value === "string" ? JSON.parse(value) : value;
  }

  test('rejected', () => {
    const code = res.status;
    expect([200, 400, 401, 404]).to.include(code);
    if (code === 200) {
      expect(__json().code).to.not.eql(0);
    }
  });
}
