    {
      "name": "01 Bootstrap operator via auth",
      "item": [
        {
          "name": "Register operator",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const CryptoJS = require('crypto-js');",
                  "",
                  "function sha256Hex(message) {",
                  "  return CryptoJS.SHA256(CryptoJS.enc.Utf8.parse(String(message))).toString(CryptoJS.enc.Hex);",
                  "}",
                  "",
                  "const requestBody = pm.request.body.raw;",
                  "let bodyData = JSON.parse(requestBody);",
                  "",
                  "if (bodyData.password) {",
                  "  bodyData.password = sha256Hex(bodyData.password);",
                  "}",
                  "",
                  "if (Array.isArray(bodyData.items)) {",
                  "  bodyData.items.forEach((item) => {",
                  "    if (item && item.password) {",
                  "      item.password = sha256Hex(item.password);",
                  "    }",
                  "  });",
                  "}",
                  "",
                  "pm.request.body.raw = JSON.stringify(bodyData);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('HTTP 200', () => pm.expect(pm.response.code).to.eql(200));",
                  "pm.test('business code 0', () => pm.expect(json.code).to.eql(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{X-Request-ID}}",
                "type": "text"
              }
            ],
            "url": "{{auth_base}}/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login_id\": \"{{operator_login_id}}\",\n  \"username\": \"{{operator_login_id}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"{{operator_email}}\"\n}\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login operator",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const CryptoJS = require('crypto-js');",
                  "",
                  "const requestId = pm.collectionVariables.get(\"X-Request-ID\");",
                  "if (!requestId) {",
                  "  throw new Error(\"X-Request-ID not found\");",
                  "}",
                  "",
                  "const requestBody = pm.request.body.raw;",
                  "let bodyData = JSON.parse(requestBody);",
                  "",
                  "function sha256Hex(message) {",
                  "  return CryptoJS.SHA256(CryptoJS.enc.Utf8.parse(String(message))).toString(CryptoJS.enc.Hex);",
                  "}",
                  "",
                  "if (bodyData.password) {",
                  "  const h1 = sha256Hex(bodyData.password);",
                  "  const timestampSec = Math.floor(Date.now() / 1000);",
                  "  bodyData.password = sha256Hex(`${h1}:${timestampSec}:${requestId}`);",
                  "  pm.request.body.raw = JSON.stringify(bodyData);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Parse response body",
                  "const body = pm.response.json();",
                  "const tokenObj = (body.data && (body.data.token || body.data.Token)) || {};",
                  "const accessToken = tokenObj.access_token;",
                  "",
                  "if (body.code !== 0 || !accessToken) {",
                  "    throw new Error(`Login failed: ${body.message || 'No access_token in response'}`);",
                  "}",
                  "",
                  "console.log('✅ Login successful:', body.message);",
                  "",
                  "// Save to environment (or collection variables)",
                  "pm.collectionVariables.set('Token', 'Bearer ' + accessToken);",
                  "if (body.data.user_id !== undefined && body.data.user_id !== null) {",
                  "    const userId = pm.response.text().match(/\"user_id\"\\s*:\\s*(\\d+)/);",
                  "    pm.collectionVariables.set('user_id', userId[1]);",
                  "}",
                  "",
                  "pm.test('HTTP 200', () => pm.expect(pm.response.code).to.eql(200));",
                  "pm.test('business code 0', () => pm.expect(body.code).to.eql(0));",
                  "",
                  "pm.collectionVariables.set('operator_token', pm.collectionVariables.get('Token'));",
                  "const operatorUserId = pm.response.text().match(/\"user_id\"\\s*:\\s*(\\d+)/);",
                  "pm.collectionVariables.set('operator_user_id', operatorUserId[1]);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{X-Request-ID}}",
                "type": "text"
              }
