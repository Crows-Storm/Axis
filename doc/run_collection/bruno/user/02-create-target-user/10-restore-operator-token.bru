meta {
  name: Restore operator token
  type: http
  seq: 10
}
get {
  url: {{user_base}}/ping
  body: none
  auth: none
}
headers {
  X-Request-ID: {{X-Request-ID}}
}
script:pre-request {
  bru.setVar('access_token', bru.getVar('operator_token'));

  bru.setVar('Token', bru.getVar('operator_token'));
}
tests {
  function __raw() {
    const value = res.getBody();
    return typeof value === "string" ? value : JSON.stringify(value);
  }

  function __json() {
    const value = res.getBody();
    return typeof value === "string" ? JSON.parse(value) : value;
  }

  const json = __json();
  test('HTTP 200', () => expect(res.status).to.eql(200));
  test('business code 0', () => expect(json.code).to.eql(0));
}
