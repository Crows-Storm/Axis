meta {
  name: Hide menu
  type: http
  seq: 4
}
patch {
  url: {{auth_base}}/rbac/menus/{{menu_id}}/status
  body: json
  auth: inherit
}
headers {
  X-Request-ID: {{X-Request-ID}}
}
body:json {
  {
    "status": 0
  }
}
tests {
  function __raw() {
    const value = res.getBody();
    return typeof value === "string" ? value : JSON.stringify(value);
  }

  function __json() {
    const value = res.getBody();
    return typeof value === "string" ? JSON.parse(value) : value;
  }

  const json = __json();
  test('HTTP 200', () => expect(res.status).to.eql(200));
  test('business code 0', () => expect(json.code).to.eql(0));
}
