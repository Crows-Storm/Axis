# ===========================================
# LOGGER runtime env config e.g.: info, debug, warn, error
# ===========================================
LOG_LEVEL=debug

SERVER_NAME=audit
SERVER_HOST=localhost

# ===========================================
# Server env config
# ===========================================
REST_PORT=18806

# ===========================================
# GRPC env config
# ===========================================
GRPC_PORT=18706

# ===========================================
# JWT env config
# ===========================================
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
# second
JWT_ACCESS_TTL=7200
JWT_REFRESH_ACCESS_TTL=604800

# ===========================================
# Consul env config
# ===========================================
CONSUL_HOST=localhost
CONSUL_PORT=8500
CONSUL_ACL_TOKEN=change-me
CONSUL_TIMEOUT=5

# ===========================================
# Database env config
# ===========================================
DB_TYPE=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_LOGIN_ID=root
DB_PASSWORD=change-me
DB_SCHEMA=axis_audit
DB_SSL_MODE=disable
DB_PATH=data/audit/data.db

# ===========================================
# Redis env config
# ===========================================
REDIS_HEALTH_CHECK_INTERVAL=30
READ_REDIS_ADDRESS=localhost:6379
READ_REDIS_DB=0
READ_REDIS_DISABLE_CACHE=false
READ_REDIS_PASSWORD=my999pikaqiu@163.com

WRITE_REDIS_ADDRESS=localhost:6379
WRITE_REDIS_DB=0
WRITE_REDIS_DISABLE_CACHE=false
WRITE_REDIS_PASSWORD=my999pikaqiu@163.com

# ===========================================
# Mongo env config
# ===========================================
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=axis_audit
MONGO_AUDIT_COLLECTION=audit_events

# ===========================================
# Kafka env config
# ===========================================
KAFKA_BROKERS=127.0.0.1:29092
KAFKA_CLIENT_ID=audit
KAFKA_GROUP_ID=audit
# Audit consumes only axis.audit. Domain publishers mirror successful events onto that topic.
