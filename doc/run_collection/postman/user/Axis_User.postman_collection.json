  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function generateRequestId() {",
          "  const s4 = () => Math.floor((1 + Math.random()) * 0x10000).toString(16).substring(1);",
          "  return `${s4()}-${s4()}-${s4()}`;",
          "}",
          "",
          "const requestId = generateRequestId();",
          "pm.collectionVariables.set(\"X-Request-ID\", requestId);",
          "pm.request.headers.upsert({ key: \"X-Request-ID\", value: requestId });",
          "",
          "const token = pm.collectionVariables.get(\"Token\");",
          "const skipAuth = pm.request.auth && pm.request.auth.type === \"noauth\";",
          "if (token && !skipAuth) {",
          "  pm.request.headers.upsert({ key: \"Authorization\", value: token });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.collectionVariables.set(\"X-Request-ID\", \"\");"
        ]
      }
    }
  ]
