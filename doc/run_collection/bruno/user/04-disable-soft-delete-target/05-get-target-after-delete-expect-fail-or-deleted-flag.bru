meta {
  name: GET target after delete (expect fail or deleted flag)
  type: http
  seq: 5
}
get {
  url: {{user_base}}/{{target_user_id}}
  body: none
  auth: inherit
}
headers {
  X-Request-ID: {{X-Request-ID}}
}
tests {
  function __raw() {
    const value = res.getBody();
    return typeof value === "string" ? value : JSON.stringify(value);
  }

  function __json() {
    const value = res.getBody();
    return typeof value === "string" ? JSON.parse(value) : value;
  }

  const json = __json();
  test('HTTP 200 envelope', () => expect(res.status).to.eql(200));
}
